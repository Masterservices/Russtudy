# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# ------------------------------------------------------------------
# Plateforme RusStudy (/app) — Supabase
# Sans ces variables, /app démarre en mode démonstration (données
# fictives, lecture seule). Voir supabase/README.md.
# ------------------------------------------------------------------
# Projet Supabase du site : ugangicvbgiwncrhyexd
NEXT_PUBLIC_SUPABASE_URL="https://ugangicvbgiwncrhyexd.supabase.co"

# Clé publique, envoyée au navigateur : ce n'est pas un secret, la protection
# des données repose sur la RLS. Deux noms sont acceptés par le code —
# PUBLISHABLE_KEY (format actuel `sb_publishable_…`) est prioritaire,
# ANON_KEY (ancien JWT) sert de repli.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."
# NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJhbGci..."

# Clé de service : usage serveur uniquement (scripts d'administration,
# import de données). Ne jamais l'exposer côté navigateur.
SUPABASE_SERVICE_ROLE_KEY="<cle-service-role>"

# Webhook de réception des candidatures du site public (optionnel).
CANDIDATURE_WEBHOOK_URL=""

# ------------------------------------------------------------------
# Notifications système (Web Push)
# Générer la paire avec : node scripts/generate-vapid-keys.mjs
# Sans ces variables, les notifications restent internes à l'application :
# elles s'affichent à l'ouverture mais ne réveillent pas le téléphone.
# ------------------------------------------------------------------
# Clé publique, envoyée au navigateur pour créer l'abonnement.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""

# Clé privée : elle signe les envois. Serveur uniquement.
VAPID_PRIVATE_KEY=""

# Secret partagé entre la base et la route /api/app/push. La même valeur doit
# être enregistrée dans public.app_config (clé `push_secret`).
PUSH_HOOK_SECRET=""
