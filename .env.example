# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# ------------------------------------------------------------------
# Plateforme RusStudy (/app) — Neon
# Sans les trois premières variables, /app démarre en mode démonstration
# (données fictives, lecture seule). Voir docs/MIGRATION-NEON.md.
# ------------------------------------------------------------------
# URL Postgres POOLÉE (hôte en `-pooler`). Serveur uniquement.
DATABASE_URL=""

# Neon Auth (Managed Better Auth) : URL du service, visible dans la console
# Neon (Auth → Configuration). Serveur uniquement.
NEON_AUTH_BASE_URL=""

# Secret de signature des cookies de session, 32 caractères minimum.
# Générer avec : openssl rand -base64 32
NEON_AUTH_COOKIE_SECRET=""

# Stockage objet Neon (compatible S3) pour les pièces des dossiers et les
# médias des cours. Un seul bucket privé : préfixes `documents/` et
# `course-assets/`. Serveur uniquement.
NEON_STORAGE_BUCKET=""
NEON_STORAGE_S3_ENDPOINT=""
NEON_STORAGE_REGION=""
NEON_STORAGE_ACCESS_KEY_ID=""
NEON_STORAGE_SECRET_ACCESS_KEY=""

# Webhook de réception des candidatures du site public (optionnel).
CANDIDATURE_WEBHOOK_URL=""

# ------------------------------------------------------------------
# Notifications système (Web Push)
# Générer la paire avec : node scripts/generate-vapid-keys.mjs
# Sans ces variables, les notifications restent internes à l'application :
# elles s'affichent à l'ouverture mais ne réveillent pas le téléphone.
# ------------------------------------------------------------------
# Clé publique, envoyée au navigateur pour créer l'abonnement.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""

# Clé privée : elle signe les envois. Serveur uniquement.
VAPID_PRIVATE_KEY=""

# Secret de la route manuelle /api/app/push (en-tête x-push-secret).
PUSH_HOOK_SECRET=""
